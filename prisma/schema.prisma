// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  
  // Breeze Configuration
  breezeSubdomain String
  breezeApiKey    String
  breezeFormId    String
  
  // Email Config and Templates
  emailFrom       String   
  emailBcc        String?
  subjectTemplate String?  @db.Text
  textTemplate    String?  @db.Text
  htmlTemplate    String?  @db.Text
  
  // SMTP Configuration
  smtpHost        String?
  smtpPort        Int?
  smtpUsername    String?
  smtpPassword    String?
  smtpSecure      Boolean  @default(false)
  
  // Form field mappings
  formFieldMappings Json
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
} 